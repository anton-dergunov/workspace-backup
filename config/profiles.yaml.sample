# resticprofile configuration for workspace backup
#
# ──────────────────────────────────────────────────────────────────────────────
# CONFIGURATION NOTES
# ──────────────────────────────────────────────────────────────────────────────
#
# HOSTNAME TEMPLATES:
#   Use {{ .Hostname }} to embed the machine hostname in repository paths.
#   This allows the same config to be used across multiple machines with
#   separate backups per machine:
#     rclone:gdrive:restic-projects-{{ .Hostname }}
#
# EXCLUDE FILES:
#   Specifies files to exclude. See config/excludes.txt for an example.
#   Reference: https://restic.readthedocs.io/en/latest/040_backup.html
#
# EXCLUDE-IF-PRESENT:
#   Restic's --exclude-if-present flag. Drop a .nobackup marker file in any
#   directory to exclude that entire directory from backups.
#
# SCHEDULING:
#   For irregular laptop usage, use min-interval to implement smart skipping:
#   - Schedule fires frequently (e.g. hourly)
#   - resticprofile checks last snapshot time
#   - If it's too recent, job is skipped
#   - This ensures daily backups without strict scheduling
#   Reference: https://creativeprojects.github.io/resticprofile/schedules/
#
# GUARDRAILS (post-backup hook):
#   guardrails.py runs after each successful backup via the run-after hook.
#   resticprofile sets PROFILE_NAME in the environment automatically, which
#   guardrails.py uses to call back into resticprofile for snapshot data.
#
#   Configuration is passed as CLI arguments:
#     --max-growth-ratio RATIO          size growth vs previous snapshot
#     --max-file-count-growth-ratio R   file count growth vs previous snapshot
#     --max-new-files N                 absolute new files per run
#     --max-added-size SIZE             total data added (new+changed) per run
#     --max-total-size SIZE             absolute total snapshot size cap
#     --no-warn-on-new-extensions       disable new extension warnings
#
#   Size values accept KB, MB, GB, KiB, MiB, GiB suffixes.
#
#   On violation: sends a desktop notification via terminal-notifier (optional)
#   and exits non-zero, marking the job as failed in resticprofile.
#
# RETENTION:
#   The retention section runs the restic forget + prune workflow
#   after each backup completes (if after-backup: true).
#
#   Example policy keeps:
#   - 7 daily snapshots
#   - 8 weekly snapshots
#   - 12 monthly snapshots
#   - 5 yearly snapshots
#
# RESTICPROFILE SETUP:
#   1. Install resticprofile: brew install resticprofile
#   2. Place this file at: ~/.config/resticprofile/profiles.yaml
#      (or use --config flag to point to this directory)
#   3. Configure rclone remotes: rclone config
#   4. Initialize repositories:
#      restic -r rclone:gdrive:restic-backup-$(hostname) init
#   5. Test dry-run: resticprofile -n backup
#   6. Install scheduling: resticprofile schedule


version: "1"

default:
  repository: "rclone:gdrive:restic-backup-{{ .Hostname }}"
  password-file: "~/.config/restic/password"

  backup:
    source:
      - "~/my_dir1"
      - "~/my_dir2"

    tags:
      - workstation

    exclude-file:
      - "/path/to/workspace-backup-repo/config/excludes.txt"
    exclude-if-present: ".nobackup"
    skip-if-unchanged: true

    schedule: hourly
    schedule-log: "/Users/YOUR_USERNAME/resticprofile-backup.log"
    schedule-priority: background

    run-after:
      - >-
        python3 /path/to/workspace-backup-repo/scripts/guardrails.py
        --max-growth-ratio 1.2
        --max-file-count-growth-ratio 1.2
        --max-new-files 100
        --max-added-size 10MB
        --max-total-size 5GB

  # retention:
  #   after-backup: true
  #   keep-daily: 7
  #   keep-weekly: 8
  #   keep-monthly: 12
  #   keep-yearly: 5
  #   prune: true
